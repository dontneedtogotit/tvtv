# tvtv HTPC Appliance Environment Variables
# Copy this file to .env and fill in your values.

# ── Agentic AI Assistant (Kilo Gateway) ───────────────────────────────────────
# Get your free API key from https://kilo.ai
# The assistant rotates between free models automatically:
#   kilo-auto/free, dots-studio/dots-3-note-preview:free,
#   stealth/space-bunny-alpha, stepfun/step-3.7-flash:free
KILO_API_KEY=your_kilo_api_key_here
KILO_GATEWAY_URL=https://api.kilo.ai/api/gateway

# ── Backend ───────────────────────────────────────────────────────────────────
TVTV_PORT=8000

# ── TV Profile ────────────────────────────────────────────────────────────────
# These are normally written by the installer to ~/.config/tvtv/tv.conf
# but can be overridden here for development.
# WLR_OUTPUT=HDMI-A-1
# WLR_MODE=1920x1080@60
# TV_SCALE=13
# TV_AUDIO=hdmi
# TV_CEC=yes
# TV_THEME=estuary
# TV_SHELL=labwc
