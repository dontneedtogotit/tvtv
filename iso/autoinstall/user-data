#cloud-config
# tvtv HTPC Operating System (Ubuntu 24.04 LTS Noble Autoinstall)
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
    variant: ''
  network:
    network:
      version: 2
      ethernets:
        default:
          match:
            name: e*
          dhcp4: true
          dhcp6: false
      optional: true
      wifi:
        optional: true
  storage:
    layout:
      name: direct
    swap:
      size: 0
  identity:
    hostname: tvtv-livingroom
    username: htpc
    password: $6$tvtv2026$dbd.bIB6vHtdfhOgQvdigyFFvnyTlomCarkjxFMO3SdVw0Hi1fqzh7UzLQoojVDKOFKYDk6jyuiZjtqfqCnWk1
    realname: HTPC User
    groups:
    - adm
    - cdrom
    - dip
    - plugdev
    - sudo
    - video
    - render
    - audio
    - input
    - nopasswdlogin
    - dialout
    - uinput
    shell: /bin/bash
  ssh:
    allow-pw: true
    install-server: true
  packages:
  - linux-firmware
  - linux-generic-hwe-24.04
  - intel-microcode
  - iucode-tool
  - thermald
  - lm-sensors
  - curl
  - wget
  - git
  - python3
  - python3-venv
  - python3-pip
  - mpv
  - yt-dlp
  - labwc
  - cage
  - swaybg
  - polkitd
  - seatd
  - dbus-x11
  - xwayland
  - mesa-va-drivers
  - intel-media-va-driver-non-free
  - chromium-browser
  - chromium
  - cec-utils
  - ir-keytable
  - ydotool
  - ydotoold
  - playerctl
  - pipewire
  - pipewire-audio-client-libraries
  - wireplumber
  - alsa-utils
  - fonts-noto
  - fonts-noto-color-emoji
  - xdg-utils
  - zram-tools
  - chrony
  - ethtool
  - openssh-server
  - samba
  late-commands:
  - curtin in-target --target=/target -- sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet"/' /etc/default/grub
  - curtin in-target --target=/target -- update-grub
  - 'curtin in-target --target=/target -- sh -c ''mkdir -p /etc/sudoers.d && printf "%sudo ALL=(ALL) NOPASSWD: ALL\nhtpc ALL=(ALL) NOPASSWD: ALL\n" > /etc/sudoers.d/90-tvtv && chmod 0440 /etc/sudoers.d/90-tvtv'''
  - curtin in-target --target=/target -- sh -c 'mkdir -p /etc/xdg && printf "[Daemon]\nAutolock=false\nLockGrace=0\nLockOnResume=false\nTimeout=0\n" > /etc/xdg/kscreenlockerrc'
  - curtin in-target --target=/target -- sh -c 'mkdir -p /etc/xdg && printf "[Wallet]\nEnabled=false\nFirst Use=false\n" > /etc/xdg/kwalletrc'
  - curtin in-target --target=/target -- chage -M 99999 -m 0 htpc
  - curtin in-target --target=/target -- mkdir -p /etc/systemd/logind.conf.d
  - curtin in-target --target=/target -- sh -c 'printf "[Login]\nHandleLidSwitch=ignore\nHandleLidSwitchExternalPower=ignore\nHandleLidSwitchDocked=ignore\nIdleAction=ignore\n" > /etc/systemd/logind.conf.d/10-tvtv.conf'
  - curtin in-target --target=/target -- sh -c 'mkdir -p /etc/modules-load.d && echo uinput > /etc/modules-load.d/uinput.conf'
  - curtin in-target --target=/target -- sh -c 'printf "KERNEL==\"uinput\", SUBSYSTEM==\"misc\", MODE=\"0660\", GROUP=\"uinput\", OPTIONS+=\"static_node=uinput\"\n" > /etc/udev/rules.d/80-uinput.rules'
  - curtin in-target --target=/target -- sh -c 'printf "KERNEL==\"cec[0-9]*\", SUBSYSTEM==\"cec\", MODE=\"0666\", GROUP=\"dialout\"\nKERNEL==\"ttyACM[0-9]*\", SUBSYSTEM==\"tty\", MODE=\"0666\", GROUP=\"dialout\"\nKERNEL==\"ttyUSB[0-9]*\", SUBSYSTEM==\"tty\", MODE=\"0666\", GROUP=\"dialout\", ATTRS{idVendor}==\"1a44\"\n" > /etc/udev/rules.d/99-cec-adapter.rules'
  - curtin in-target --target=/target -- sh -c 'printf "PERCENTAGE=50\nPRIORITY=100\n" > /etc/default/zramswap'
  - sh -c 'if [ -d /home/htpc/tvtv ]; then cp -a /home/htpc/tvtv /target/home/htpc/tvtv; fi'
  - curtin in-target --target=/target -- bash -c 'if [ ! -d /home/htpc/tvtv ]; then git clone --depth 1 https://github.com/dontneedtogotit/tvtv.git /home/htpc/tvtv; fi'
  - curtin in-target --target=/target -- chown -R htpc:htpc /home/htpc/tvtv
  - curtin in-target --target=/target -- bash -c 'mkdir -p /home/htpc/.config/tvtv && echo 
    | base64 -d > /home/htpc/.config/tvtv/tv.conf && chown -R htpc:htpc /home/htpc/.config/tvtv'
  - curtin in-target --target=/target -- bash /home/htpc/tvtv/scripts/setup.sh
  shutdown: reboot
instance-id: tvtv-htpc-noble
local-hostname: tvtv-livingroom
