#cloud-config
# tvtv HTPC Operating System (Ubuntu 24.04 LTS Noble Autoinstall)
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
    variant: ''
  network:
    network:
      version: 2
      ethernets:
        default:
          match:
            name: e*
          dhcp4: true
          dhcp6: false
      optional: true
  storage:
    layout:
      name: direct
    swap:
      size: 0
  identity:
    hostname: tvtv-livingroom
    username: htpc
    password: $6$tvtv2026$dbd.bIB6vHtdfhOgQvdigyFFvnyTlomCarkjxFMO3SdVw0Hi1fqzh7UzLQoojVDKOFKYDk6jyuiZjtqfqCnWk1
    realname: HTPC User
  ssh:
    allow-pw: true
    install-server: true
  packages:
  - openssh-server
  - curl
  - wget
  - git
  - python3
  - python3-venv
  - python3-pip
  - chrony
  - ethtool
  - linux-firmware
  - linux-generic-hwe-24.04
  late-commands:
  - curtin in-target --target=/target -- sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="quiet"/' /etc/default/grub
  - curtin in-target --target=/target -- update-grub
  - sh -c 'mkdir -p /target/home/htpc/tvtv && (cp -a /cdrom/tvtv/. /target/home/htpc/tvtv/ 2>/dev/null || cp -a /home/htpc/tvtv/. /target/home/htpc/tvtv/ 2>/dev/null || true)'
  - curtin in-target --target=/target -- bash -c 'if [ ! -f /home/htpc/tvtv/scripts/setup.sh ]; then git clone --depth 1 https://github.com/dontneedtogotit/tvtv.git /home/htpc/tvtv 2>/dev/null || true; fi'
  - curtin in-target --target=/target -- chown -R htpc:htpc /home/htpc/tvtv
  - curtin in-target --target=/target -- bash -c 'if [ -f /home/htpc/tvtv/scripts/setup.sh ]; then bash /home/htpc/tvtv/scripts/setup.sh 2>&1 | tee /var/log/tvtv-setup.log; fi'
  - curtin in-target --target=/target -- bash -c '[ -f /etc/systemd/system/getty@tty1.service.d/autologin.conf ] && [ -x /usr/local/bin/tvtv-session ] || { echo "TVTV SETUP INCOMPLETE - autologin drop-in or tvtv-session missing (see /var/log/tvtv-setup.log)" | tee /var/log/tvtv-setup-failed.log; exit 1; }'
  shutdown: reboot
instance-id: tvtv-htpc-noble
local-hostname: tvtv-livingroom
