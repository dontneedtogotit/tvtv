[Unit]
Description=tvtv-yt HTPC YouTube Frontend
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=htpc
WorkingDirectory=/home/htpc/tvtv
ExecStart=/home/htpc/tvtv/scripts/start.sh
Restart=on-failure
RestartSec=5
Environment=TVTV_PORT=8000

# Hardware acceleration for MPV (VAAPI decode via render node)
Environment=LIBVA_DRIVER_NAME=iHD
DeviceAllow=/dev/dri/card0 rwm
DeviceAllow=/dev/dri/renderD128 rwm

# ── Sandboxing & Resource Hardening (Phase 8) ────────────────────────────────
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/htpc/tvtv /home/htpc/.config /home/htpc/.cache /tmp /run
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
MemoryMax=4G
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
